{
  "name": "obsidian-google-drive-sync-for-internal-use",
  "version": "0.1.0",
  "description": "Collaborate with your team via Google Workspace shared drives within your company.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "sync",
    "google-drive",
    "shared-drive",
    "google-workspace"
  ],
  "author": "Masato Uehara",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.2",
    "esbuild": "0.28.2",
    "obsidian": "1.13.0",
    "tslib": "2.6.2",
    "typescript": "5.4.5",
    "vitest": "5.0.0"
  }
}
